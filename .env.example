# Modelo das variáveis de produção. No Dokploy, preencha na aba "Environment" do recurso.

# Obrigatória. Gere uma chave exclusiva para este ambiente:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cookie seguro deve permanecer true quando publicado atrás de HTTPS (Traefik do Dokploy).
COOKIE_SECURE=true

# Pastas fixas da VPS para o banco e os backups diários. O Dokploy clona o código de novo a
# cada deploy, então elas precisam ficar fora do repositório. Vazias, usam os padrões abaixo.
# DATA_DIR=/srv/fabrica-livros/data
# BACKUP_DIR=/srv/fabrica-livros/backups
DATA_DIR=
BACKUP_DIR=

# Backup diário do banco: hora em UTC (6 = 03:00 de Brasília) e quantas cópias guardar.
BACKUP_HOUR_UTC=6
BACKUP_KEEP=14

# Opcional. Vazio usa o ano do calendário; defina se o calendário letivo for diferente.
SCHOOL_YEAR=

# Opcional. Login com Google (cliente OAuth "Aplicativo da Web" no Google Cloud).
# O botão só aparece com as três variáveis preenchidas. A URI precisa ser
# idêntica à cadastrada no Google, por exemplo:
# https://acervo.exemplo.ifc.edu.br/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Opcional. Limites de hardware por serviço (padrões entre parênteses). O número de CPUs não
# pode passar do que a VPS tem.
# APP_MEMORIA=768m      APP_CPUS=1.0       (Gunicorn)
# BACKUP_MEMORIA=256m   BACKUP_CPUS=0.25   (backup diário)
# NGINX_MEMORIA=128m    NGINX_CPUS=0.5     (proxy de entrada)
